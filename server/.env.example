MONGODB_URI=mongodb://localhost:27017/learning-platform
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Short-lived access JWT (legacy JWT_EXPIRATION still works as fallback)
JWT_ACCESS_EXPIRATION=15m
# Opaque refresh token TTL (stored hashed in Mongo; rotated on each refresh)
JWT_REFRESH_EXPIRATION=7d
# HttpOnly auth cookies: set true behind HTTPS in production
COOKIE_SECURE=false
PORT=3000
PUBLIC_APP_URL=http://localhost:3000
# Comma-separated browser origins allowed by CORS (hybrid + Docker client)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:8080
MAX_IMAGE_SIZE_BYTES=5242880
MAX_VIDEO_SIZE_BYTES=209715200
# Rate limits (requests per THROTTLE_TTL_MS window)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=5
THROTTLE_UPLOAD_LIMIT=30
